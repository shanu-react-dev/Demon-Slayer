      "text": "let n = 4;\nfor (let i = n; i > 0; i--) {\n  //   console.log(i);\n  let star = \"\";\n  let space = \"\";\n  for (let j = n; j >= 1; j--) {\n    if (i + j > n) {\n      star += \" *\";\n    } else {\n      space += \"  \";\n    }\n  }\n  console.log(space, star);\n}",
